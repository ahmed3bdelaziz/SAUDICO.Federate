<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Company>Saudi Constructioneers Ltd. (SAUDICO)</Company>
    <Product>SAUDICO Federate</Product>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <RevitYear Condition="'$(RevitYear)' == ''">2025</RevitYear>
    <TargetFramework Condition="'$(RevitYear)' == '2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitYear)' == '2025'">net8.0-windows</TargetFramework>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitYear)</RevitInstallDir>
    <PlatformTarget>x64</PlatformTarget><Prefer32Bit>false</Prefer32Bit><Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup Condition="'$(RequiresRevitApi)' == 'true'">
    <Reference Include="RevitAPI"><HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
