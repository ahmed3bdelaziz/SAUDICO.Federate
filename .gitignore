```gitignore
# Build artifacts
bin/
obj/
*.dll
*.exe
*.pdb
*.nupkg

# Dependencies
packages/
node_modules/
vendor/

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# Editor files
.vs/
.idea/
*.swp
*.swo

# Configuration files (if not intended for sharing)
appsettings*.json
config.json

# Temp files
*.tmp
*.temp
```