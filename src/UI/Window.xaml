<Window x:Class="SAUDICO.Federate.UI.Manager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAUDICO Federate — Federation Manager"
        Width="1180" Height="780" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9" Foreground="#172033"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Navy" Color="#0A1628" />
        <SolidColorBrush x:Key="Navy2" Color="#172A46" />
        <SolidColorBrush x:Key="Gold" Color="#C9A84C" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Border" Color="#D7DEE8" />
        <SolidColorBrush x:Key="Text" Color="#172033" />
        <SolidColorBrush x:Key="Muted" Color="#667085" />

        <Style TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="BorderBrush" Value="#C9A84C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#C9A84C" />
            <Setter Property="Foreground" Value="#0A1628" />
            <Setter Property="Padding" Value="18,9" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="3,5" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#172033" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="BorderBrush" Value="#B8C2D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="CaretBrush" Value="#172033" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="BorderBrush" Value="#B8C2D1" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="Padding" Value="7,5" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Foreground" Value="#8B6D16" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C9A84C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E6EAF0" />
            <Setter Property="VerticalGridLinesBrush" Value="#EEF1F5" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#F7F9FC" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E9EEF5" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0A1628" Padding="18,12">
            <DockPanel>
                <Image Source="Resources/icon32.png" Width="38" Height="38" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SAUDICO Federate" FontSize="25" FontWeight="Bold" Foreground="#C9A84C" />
                    <TextBlock Text="Local and central host-model federation" Foreground="#D5DCE8" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16,12,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="190" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="105" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D7DEE8" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                <WrapPanel VerticalAlignment="Center">
                    <Button Content="＋ Add RVT Files" Click="Add" />
                    <Button Content="Remove" Click="Remove" />
                    <Button Content="Clear" Click="Clear" />
                    <Button Content="Output Folder" Click="Folder" />
                    <TextBox Text="{Binding Output}" Width="420" Margin="8,4" VerticalContentAlignment="Center" />
                    <CheckBox Content="Overwrite Existing NWC" IsChecked="{Binding Settings.Overwrite}" Margin="12,4" />
                    <CheckBox Content="Enable Export Log" IsChecked="{Binding Settings.Log}" Margin="12,4" />
                    <CheckBox Content="Create CSV Export Report" IsChecked="{Binding Settings.Csv}" Margin="12,4" />
                </WrapPanel>
            </Border>

            <DataGrid x:Name="GridJobs" Grid.Row="1" ItemsSource="{Binding Jobs}"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" AlternationCount="2" Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Source Model" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="140" />
                    <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="140" />
                    <DataGridTextColumn Header="Output" Binding="{Binding Output}" Width="2*" />
                    <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>

                <GroupBox Header="NWC Content">
                    <StackPanel>
                        <CheckBox Content="Export Revit Linked Files" IsChecked="{Binding Settings.ExportLinks}" />
                        <CheckBox Content="Export Element IDs" IsChecked="{Binding Settings.ElementIds}" />
                        <CheckBox Content="Export Element Properties" IsChecked="{Binding Settings.Properties}" Click="Props" />
                        <Grid Margin="3,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Parameters" VerticalAlignment="Center" Foreground="#8B6D16" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Params}" SelectedItem="{Binding Settings.Parameters}" IsEnabled="{Binding Settings.Properties}" />
                        </Grid>
                        <CheckBox Content="Find Missing Materials" IsChecked="{Binding Settings.FindMaterials}" />
                        <CheckBox Content="Divide File into Levels" IsChecked="{Binding Settings.DivideLevels}" />
                        <CheckBox Content="Export Construction Parts" IsChecked="{Binding Settings.Parts}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Column="1" Header="Optional &amp; Geometry">
                    <StackPanel>
                        <CheckBox Content="Export Linked CAD" IsChecked="{Binding Settings.LinkedCad}" />
                        <CheckBox Content="Rooms as Attributes" IsChecked="{Binding Settings.RoomAttributes}" />
                        <CheckBox Content="Room Geometry" IsChecked="{Binding Settings.RoomGeometry}" />
                        <CheckBox Content="Lights" IsChecked="{Binding Settings.Lights}" />
                        <CheckBox Content="URLs" IsChecked="{Binding Settings.Urls}" />
                        <Grid Margin="3,3"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBlock Text="Coordinates" VerticalAlignment="Center" Foreground="#8B6D16"/><ComboBox Grid.Column="1" ItemsSource="{Binding Coords}" SelectedItem="{Binding Settings.Coordinates}" /></Grid>
                        <Grid Margin="3,3"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBlock Text="Detail Level" VerticalAlignment="Center" Foreground="#8B6D16"/><ComboBox Grid.Column="1" ItemsSource="{Binding Details}" SelectedItem="{Binding Settings.Detail}" /></Grid>
                        <Grid Margin="3,3"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBlock Text="Faceting 0.10–10" VerticalAlignment="Center" Foreground="#8B6D16"/><TextBox Grid.Column="1" Text="{Binding Settings.Faceting}" /></Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Column="2" Header="Federation Exclusions">
                    <StackPanel>
                        <CheckBox Content="Exclude Room Separation Lines" IsChecked="{Binding Settings.ExRoom}" />
                        <CheckBox Content="Exclude Space Separation Lines" IsChecked="{Binding Settings.ExSpace}" />
                        <CheckBox Content="Exclude Area Boundary Lines" IsChecked="{Binding Settings.ExArea}" />
                        <CheckBox Content="Exclude All Model Lines" IsChecked="{Binding Settings.ExModelLines}" />
                        <CheckBox Content="Exclude Annotation Categories" IsChecked="{Binding Settings.ExAnnotations}" />
                        <CheckBox Content="Exclude Analytical Categories" IsChecked="{Binding Settings.ExAnalytical}" />
                        <CheckBox Content="Exclude Coordination Models" IsChecked="{Binding Settings.ExCoordination}" />
                        <CheckBox Content="Exclude IFC Links" IsChecked="{Binding Settings.ExIfc}" />
                    </StackPanel>
                </GroupBox>
            </Grid>

            <TextBox Grid.Row="3" Text="{Binding Log}" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Background="#FFFFFF" Foreground="#172033"
                     BorderBrush="#CBD5E1" Margin="0,8,0,8" />

            <DockPanel Grid.Row="4">
                <TextBlock Text="SAUDICO Federation Export Standard v1.0" Foreground="#667085" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Restore SAUDICO Defaults" Click="Defaults" />
                    <Button Content="Save as My Default" Click="SaveDefault" />
                    <Button Content="Run Federation Export" Click="Run" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
