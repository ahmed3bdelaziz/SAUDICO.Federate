<UserControl x:Class="SAUDICO.Federate.UI.AuthPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Border Background="#FFFFFF" BorderBrush="#D7DEE8" BorderThickness="1" CornerRadius="4" Padding="10">
        <StackPanel>
            <TextBlock Text="Autodesk Construction Cloud" FontWeight="Bold" Foreground="#172033" Margin="0,0,0,6" />

            <StackPanel Visibility="{Binding IsDisabledOrConfigInvalid, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#8B1E1E" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVis}}">
                <Button Content="Sign in with Autodesk" Command="{Binding SignInCommand}" HorizontalAlignment="Left" Padding="10,4" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Waiting for Autodesk sign-in…" Foreground="#667085" Margin="0,0,0,6" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Left" Padding="10,4" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" Orientation="Horizontal">
                <TextBlock Foreground="#172033" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Run Text="Signed in as " /><Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
                <Button Content="Sign out" Command="{Binding SignOutCommand}" Padding="10,4" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#8B1E1E" TextWrapping="Wrap" Margin="0,0,0,6" />
                <Button Content="Retry" Command="{Binding RetryCommand}" HorizontalAlignment="Left" Padding="10,4" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
