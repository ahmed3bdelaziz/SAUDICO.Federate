<Window x:Class="SAUDICO.Federate.UI.AccBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAUDICO Federate — Autodesk Construction Cloud"
        Width="880" Height="620" MinWidth="640" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="#F5F7FA" ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#172033" CornerRadius="4" Padding="10" Margin="0,0,0,12">
            <TextBlock Text="ACC Browser" Foreground="#D6B24A" FontWeight="Bold" FontSize="16" />
        </Border>

        <ContentControl x:Name="Host" Grid.Row="1" />
        <ContentControl x:Name="BrowseHost" Grid.Row="2" />
    </Grid>
</Window>
