<Window x:Class="SAUDICO.Federate.UI.Manager" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SAUDICO Federate — Federation Manager" Width="1120" Height="720" Background="#0A1628" Foreground="#EEF2F8"><Window.Resources><Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="14,8"/><Setter Property="Background" Value="#172A46"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#C9A84C"/></Style><Style TargetType="CheckBox"><Setter Property="Margin" Value="3"/></Style><Style TargetType="GroupBox"><Setter Property="Foreground" Value="#C9A84C"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="8"/></Style></Window.Resources><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="100"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Image Source="Resources/icon32.png" Width="32" Height="32" Margin="0,0,10,0"/><StackPanel><TextBlock Text="SAUDICO Federate" FontSize="26" FontWeight="Bold" Foreground="#C9A84C"/><TextBlock Text="Local and central host-model federation" Foreground="#AAB6C8"/></StackPanel></DockPanel><WrapPanel Grid.Row="1" Margin="0,12"><Button Content="＋ Add RVT Files" Click="Add"/><Button Content="Remove" Click="Remove"/><Button Content="Clear" Click="Clear"/><Button Content="Output Folder" Click="Folder"/><TextBox Text="{Binding Output}" Width="420" Margin="8,4"/><CheckBox Content="Overwrite Existing NWC" IsChecked="{Binding Settings.Overwrite}"/></WrapPanel><DataGrid x:Name="GridJobs" Grid.Row="2" ItemsSource="{Binding Jobs}" AutoGenerateColumns="False" Background="#101F35" Foreground="White"><DataGrid.Columns><DataGridTextColumn Header="Source Model" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="140"/><DataGridTextColumn Header="Status" Binding="{Binding State}" Width="140"/><DataGridTextColumn Header="Output" Binding="{Binding Output}" Width="2*"/><DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="2*"/></DataGrid.Columns></DataGrid><Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><GroupBox Header="NWC Content"><StackPanel><CheckBox Content="Export Revit Linked Files" IsChecked="{Binding Settings.ExportLinks}"/><CheckBox Content="Export Element IDs" IsChecked="{Binding Settings.ElementIds}"/><CheckBox Content="Export Element Properties" IsChecked="{Binding Settings.Properties}" Click="Props"/><StackPanel Orientation="Horizontal"><TextBlock Text="Parameters" Width="120"/><ComboBox Width="130" ItemsSource="{Binding Params}" SelectedItem="{Binding Settings.Parameters}" IsEnabled="{Binding Settings.Properties}"/></StackPanel><CheckBox Content="Find Missing Materials" IsChecked="{Binding Settings.FindMaterials}"/><CheckBox Content="Divide File into Levels" IsChecked="{Binding Settings.DivideLevels}"/><CheckBox Content="Export Construction Parts" IsChecked="{Binding Settings.Parts}"/></StackPanel></GroupBox><GroupBox Grid.Column="1" Header="Optional &amp; Geometry"><StackPanel><CheckBox Content="Export Linked CAD" IsChecked="{Binding Settings.LinkedCad}"/><CheckBox Content="Rooms as Attributes" IsChecked="{Binding Settings.RoomAttributes}"/><CheckBox Content="Room Geometry" IsChecked="{Binding Settings.RoomGeometry}"/><CheckBox Content="Lights" IsChecked="{Binding Settings.Lights}"/><CheckBox Content="URLs" IsChecked="{Binding Settings.Urls}"/><StackPanel Orientation="Horizontal"><TextBlock Text="Coordinates" Width="120"/><ComboBox Width="130" ItemsSource="{Binding Coords}" SelectedItem="{Binding Settings.Coordinates}"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Detail Level" Width="120"/><ComboBox Width="130" ItemsSource="{Binding Details}" SelectedItem="{Binding Settings.Detail}"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Faceting 0.1–10" Width="120"/><TextBox Width="130" Text="{Binding Settings.Faceting}"/></StackPanel></StackPanel></GroupBox><GroupBox Grid.Column="2" Header="Federation Exclusions"><StackPanel><CheckBox Content="Exclude Room Separation Lines" IsChecked="{Binding Settings.ExRoom}"/><CheckBox Content="Exclude Space Separation Lines" IsChecked="{Binding Settings.ExSpace}"/><CheckBox Content="Exclude Area Boundary Lines" IsChecked="{Binding Settings.ExArea}"/><CheckBox Content="Exclude All Model Lines" IsChecked="{Binding Settings.ExModelLines}"/><CheckBox Content="Exclude Annotation Categories" IsChecked="{Binding Settings.ExAnnotations}"/><CheckBox Content="Exclude Analytical Categories" IsChecked="{Binding Settings.ExAnalytical}"/><CheckBox Content="Exclude Coordination Models" IsChecked="{Binding Settings.ExCoordination}"/><CheckBox Content="Exclude IFC Links" IsChecked="{Binding Settings.ExIfc}"/></StackPanel></GroupBox></Grid><TextBox Grid.Row="4" Text="{Binding Log}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#101F35" Foreground="White"/><StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Restore SAUDICO Defaults" Click="Defaults"/><Button Content="Save as My Default" Click="SaveDefault"/><Button Content="Run Federation Export" Click="Run" Background="#C9A84C" Foreground="#0A1628" FontWeight="Bold"/></StackPanel></Grid></Window>